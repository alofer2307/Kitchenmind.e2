# Plantilla sin secretos para despliegues de KitchenMind en Vercel.
# Configurar los valores reales únicamente en Vercel Environment Variables o vault seguro.
# Base de datos Turso/libSQL (si se usa este backend):
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Opcional: backend Cloudflare D1 REST, no mezclar sin estrategia de datos
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Seguridad y bootstrap de Platform
KITCHENMIND_PLATFORM_OWNER_EMAIL=
KITCHENMIND_OWNER_PASSWORD=
KITCHENMIND_PLATFORM_MFA_KEY=
NEXT_PUBLIC_APP_URL=

# Correo transaccional — configurar solo si aplica
RESEND_API_KEY=

# Evidencias privadas de Calidad:
# En Vercel el bucket anterior NO está conectado; no asumir disponibilidad.
# No almacenar documentos médicos en el espacio general de evidencias.
