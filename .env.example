# Primary database (Turso/libSQL)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# KitchenMind platform owner bootstrap and MFA protection
KITCHENMIND_PLATFORM_OWNER_EMAIL=
KITCHENMIND_OWNER_PASSWORD=
