# Public deployment origin, without a trailing slash
NEXT_PUBLIC_APP_URL=

# Optional password-recovery email delivery
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Optional legacy Cloudflare D1 alternative to Turso
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=
